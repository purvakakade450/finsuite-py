# Copy this file to .env and fill in what you need. Everything is optional.
# .env is private and is not uploaded to GitHub.

# AI Assistant and Hindi/Marathi translations. Choose ONE of the two options.
# Option A, FREE (no payment): a key from Google AI Studio https://aistudio.google.com/apikey
#   or Groq https://console.groq.com/keys. Free plans have daily limits; the provider may reuse prompts.
AI_API_KEY=
AI_PROVIDER=gemini
# Option B, paid Claude: key from https://console.anthropic.com/settings/keys (needs prepaid credit)
ANTHROPIC_API_KEY=

# Email for alerts, password resets and confirmations. For Gmail use an App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=FinSuite Alerts <you@gmail.com>

# Telegram alerts: create a bot with @BotFather and paste its token
TELEGRAM_BOT_TOKEN=

# Address used in emailed links, and who gets the uptime alert (production only)
PUBLIC_URL=
ADMIN_EMAIL=
